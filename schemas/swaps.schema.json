{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "qualities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "swaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "alternatives": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ingredient": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "ratio": {
                  "default": 1,
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "quality": {
                  "default": "fine",
                  "description": "Quality id from `qualities` in swaps.yaml.",
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "ingredient"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ingredient",
          "alternatives"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "qualities",
    "swaps"
  ],
  "additionalProperties": false
}
