{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "oven": {
      "default": "fan",
      "type": "string",
      "enum": [
        "fan",
        "conventional"
      ]
    },
    "hob": {
      "description": "e.g. 'gas', 'induction'.",
      "type": "string"
    },
    "tools": {
      "default": [],
      "description": "Tool ids owned.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
