# Copy to .env. One file at the repository root, read by Vite (web) through envDir.
# Only keys prefixed VITE_ are exposed to the browser: never put secrets under that prefix.

# Optional: pin the dev server port. Leave unset and `make dev` picks a free random port.
# WEB_PORT=5173

# Base path of the built site. Use /<repo-name>/ (for example /fud/) when deploying to GitHub Pages under a project path.
VITE_BASE=/

# Title shown in the nav bar and browser tab.
VITE_APP_TITLE=Fud
